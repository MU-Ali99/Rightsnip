{
  "manifest_version": 3,
  "name": "RightSnip",
  "version": "0.2",
  "description": "Capture screenshots directly from the browser's right-click context menu.",

  "permissions": [
    "contextMenus",
    "tabs",
    "downloads",
    "activeTab",
    "scripting"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/icon4.png",
    "32": "icons/icon4.png",
    "48": "icons/icon4.png",
    "128": "icons/icon4.png"
  }
}